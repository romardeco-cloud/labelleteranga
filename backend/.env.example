DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.labelleteranga.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://labelleteranga.com,https://www.labelleteranga.com

# Postgres (Render will inject DATABASE_URL automatically in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/labelleteranga

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=xof

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Wave for Business (https://docs.wave.com/business)
WAVE_API_KEY=
WAVE_CURRENCY=XOF

# Orange Money Web Payment (https://developer.orange.com/apis/om-webpay)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CURRENCY=XOF

# WhatsApp Cloud API (Meta) - voir backend/apps/notifications/whatsapp.py
# pour la procedure complete (creation app Meta, token permanent, et texte
# exact du modele de message a faire approuver). Laisser ACCESS_TOKEN/
# PHONE_NUMBER_ID vides pour utiliser uniquement les liens wa.me manuels.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_SHOP_NUMBER=221770000000

# Compte admin (utilise avec: python manage.py createsuperuser --noinput, ou saisi manuellement)
DJANGO_SUPERUSER_EMAIL=info@labelleteranga.com
DJANGO_SUPERUSER_USERNAME=admin
